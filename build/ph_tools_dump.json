    {
      "tool": "ph_dataset_metadata",
      "description": "Alias of ph_dataset_show for Singapore-style naming. Get HDX package metadata by id/name.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "CKAN package id or name, for example 'cod-ab-phl'."
          }
        },
        "required": [
          "id"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "tool": "ph_dataset_query",
      "description": "Query tabular HDX datastore records by resource_id (CKAN datastore_search). No API key required.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "resource_id": {
            "type": "string",
            "minLength": 1,
            "description": "CKAN resource id that has datastore enabled."
          },
          "limit": {
            "default": 10,
            "description": "Maximum records to return.",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "offset": {
            "default": 0,
            "description": "Record offset for pagination.",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "q": {
            "description": "Optional full-text query across datastore fields.",
            "type": "string"
          },
          "filters": {
            "description": "Optional JSON filters string, for example '{\"col\":\"value\"}'.",
            "type": "string"
          },
          "sort": {
            "description": "Optional sort expression, for example 'col asc'.",
            "type": "string"
          },
          "fields": {
            "description": "Optional comma-separated field list to return.",
            "type": "string"
          }
        },
        "required": [
          "resource_id"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "tool": "ph_dataset_show",
      "description": "Get full HDX dataset metadata and resources by package id or name. No API key required.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "description": "CKAN package id or name, for example 'cod-ab-phl'."
          }
        },
        "required": [
          "id"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
