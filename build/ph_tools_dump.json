{
  "mode": "namespace",
  "namespace": "user-monstarx-philippines",
  "namespaceStatus": "ready",
  "tools": [
    {
      "tool": "mcp_auth",
      "description": "Authenticate this MCP server so its tools can be used.",
      "inputSchema": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      }
    },
    {
      "tool": "ph_address_search",
      "description": "Search Philippine addresses, place names, and landmarks using OpenStreetMap Nominatim. No API key required.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "description": "Philippine address or place name, for example 'Intramuros' or 'Ayala Avenue Makati'."
          },
          "limit": {
            "default": 10,
            "description": "Maximum results to return.",
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          }
        },
        "required": [
          "query"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "tool": "ph_air_quality",
      "description": "Get hourly air quality (PM2.5, PM10, NO2, O3, SO2, CO, European AQI) for a starter city code. No API key required.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "area_code": {
            "default": "manila",
            "description": "Starter city code, for example 'manila' for Manila.",
            "type": "string"
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#"
      }
    },
    {
      "tool": "ph_air_temperature",
